# Optional public business email shown beside the WhatsApp enquiry. Never add secrets here.
PUBLIC_CONTACT_EMAIL=
# Optional canonical origin override. Production defaults to https://www.mlabsgrowth.com.
# Local review remains noindex when this is empty.
PUBLIC_SITE_URL=

# Set false on staging/preview builds. Production is indexable by default.
PUBLIC_SITE_INDEXABLE=true
# Optional Search Console HTML verification token, not a Google API key.
PUBLIC_GOOGLE_SITE_VERIFICATION=
