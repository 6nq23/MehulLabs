---
import Layout from '@/layouts/Layout.astro';
import { guides } from '@/data/guides';
import { tools } from '@/data/tools';
import { serviceRoutes } from '@/data/services';
import { site } from '@/data/site';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
interface Props { guide: (typeof guides)[number] }
const { guide } = Astro.props;
const tool = tools.find(item => item.slug === guide.tool)!;
const service = serviceRoutes.find(item => item.slug === guide.service)!;
---
<Layout><article class="growth-page">
  <header class="growth-page-hero shell"><p class="eyebrow-accent">MLABS GROWTH · PRACTICAL GUIDE</p><h1>{guide.title}</h1><p class="growth-lead">{guide.intro}</p><p class="growth-note">Published <time datetime="2026-09-18">18 September 2026</time> · By <a class="text-link" href="/about">MLabs Growth</a></p></header>
  <div class="shell seo-article"><nav class="growth-card" aria-label="On this page"><h2>In this guide</h2><ol>{guide.sections.map(section => <li><a class="text-link" href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>
  {guide.sections.map(section => <section id={section.id} class="seo-article-section"><h2>{section.title}</h2><p>{section.body}</p><ul>{section.items.map(item => <li>{item}</li>)}</ul></section>)}
  {guide.sources.length > 0 && <aside class="seo-article-section"><h2>Further reading</h2><ul>{guide.sources.map(source => <li><a class="text-link" href={source.url}>{source.label} ↗</a></li>)}</ul></aside>}
  <section class="growth-card"><h2>Apply this to your next decision</h2><p>Use your own inputs in the {tool.title.toLowerCase()}, or review what a scoped {service.navLabel.toLowerCase()} engagement includes.</p><nav class="seo-related" aria-label="Related tools and services"><a class="text-link" href={`/tools/${tool.slug}`}>{tool.title} ↗</a><a class="text-link" href={`/services/${service.slug}`}>{service.navLabel} services ↗</a><a class="text-link" href={site.bookingUrl}>Book a free audit call ↗</a></nav></section>
  <nav class="seo-related" aria-label="More practical guides">{guides.filter(item => item.slug !== guide.slug).map(item => <a class="text-link" href={`/guides/${item.slug}`}>{item.title} ↗</a>)}</nav>
  </div>
</article></Layout>
