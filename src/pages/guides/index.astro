---
import Layout from '@/layouts/Layout.astro';
import { guides } from '@/data/guides';
---
<Layout><div class="growth-page"><section class="growth-page-hero shell"><p class="eyebrow-accent">PRACTICAL GUIDES</p><h1>D2C growth &amp;<br /><em>AI workflow guides.</em></h1><p class="growth-lead">Check the problem, understand the numbers and choose a useful next step. These guides pair with our free calculators and scoped services.</p></section><section class="section-space shell seo-help-grid" aria-label="Guides">{guides.map(guide => <article class="growth-card"><h2>{guide.title}</h2><p>{guide.description}</p><a class="text-link" href={`/guides/${guide.slug}`}>Read the guide ↗</a></article>)}</section></div></Layout>
