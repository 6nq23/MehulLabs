---
import '@fontsource-variable/manrope/wght.css';
import { contactEmail, site } from '@/data/site';
import { pageSeo } from '@/data/seo';
import { ownedBrands, ownershipDisclosure } from '@/data/experience';
import { serviceRoutes } from '@/data/services';
import { ConversionEvents } from '@/components/providers/ConversionEvents';
import HiveNavbar from '@/components/layout/HiveNavbar.astro';
import BeeOrbit from '@/components/bees/BeeOrbit.astro';
import { beeCharacters, queenBee as queen } from '@/data/bees';
import humanStrategist from '../../asset/human-creative-strategist.png';

const { image: marketingBee } = beeCharacters.marketing;
const { image: shopifyBee } = beeCharacters.shopify;
const { image: callingBee } = beeCharacters.calling;
const seo = pageSeo['/'];
const canonicalUrl = site.url ? new URL('/', site.url).href : undefined;
const socialImageUrl = new URL('/social-preview.png', site.url || Astro.url.origin).href;
const organizationId = `${site.url}/#organization`;
const websiteId = `${site.url}/#website`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationId, name: site.name, url: site.url, email: contactEmail || undefined, description: site.tagline },
    { '@type': 'WebSite', '@id': websiteId, name: site.name, url: canonicalUrl, publisher: { '@id': organizationId }, inLanguage: 'en' },
    { '@type': 'WebPage', '@id': `${canonicalUrl}#webpage`, url: canonicalUrl, name: `${seo.title} — ${site.name}`, description: seo.description, isPartOf: { '@id': websiteId }, publisher: { '@id': organizationId }, inLanguage: 'en' },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/hero/quicksand-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fbfaf8" />
    <meta name="robots" content={site.indexable ? 'index, follow' : 'noindex, follow'} />
    <meta name="googlebot" content={`${site.indexable ? 'index, follow' : 'noindex, follow'}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`} />
    <meta name="author" content={site.name} />
    <meta name="description" content={seo.description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${seo.title} — ${site.name}`} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={socialImageUrl} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${seo.title} — ${site.name}`} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{seo.title} — {site.name}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {site.url && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body>
    <div class="hive-page">
      <a class="skip-link" href="#main">Skip to content</a>
      <ConversionEvents client:load />
      <HiveNavbar />

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title"><span>More from your store.</span><span>Less work behind it.</span></h1>
            <p class="hero-subtitle">We improve Shopify conversion, connect order operations, and build AI marketing workflows around your brand.</p>
            <a class="pill-button hero-cta" href={site.bookingUrl} data-cta-location="home-hero">
              <span>Book a free audit call</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span>
            </a>
            <p class="hero-note">Start with a free 30-minute audit. Get a written scope before paid work.</p>
          </div>

        </section>

        <section id="approach" class="approach-section" aria-labelledby="approach-title">
          <h2 id="approach-title" class="sr-only">One hive. Two ways to grow.</h2>
          <div class="offer-grid">
            <div class="offer-column">
              <div class="offer-visual human-visual">
                <span class="visual-halo" aria-hidden="true"></span>
                <img src={humanStrategist.src} width="1149" height="1368" alt="Illustrative portrait of a human strategist" fetchpriority="high" />
              </div>
              <article class="offer-card">
                <h3>Don't hire more <em>humans.</em></h3>
                <p class="offer-description">Your team already brings the strategy, creative judgment, and final approval. Give the repeatable tasks to specialist agents instead of adding another role.</p>
                <div class="offer-signature"><span class="signature-dot" aria-hidden="true"></span>Human-led. Brand-focused.</div>
                <a class="pill-button offer-cta" href="/services" data-cta-location="home-hire-humans"><span>Explore services</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span></a>
              </article>
            </div>
            <div class="offer-column">
              <div class="offer-visual agents-visual">
                <span class="visual-halo" aria-hidden="true"></span>
                <img class="offer-bee bee-queen" src={queen.src} width="1254" height="1254" alt="The queen bee leads a hive of specialist agents." />
                <img class="offer-bee bee-satellite-left" src={shopifyBee.src} width="1254" height="1254" alt="" aria-hidden="true" />
                <img class="offer-bee bee-satellite-right" src={marketingBee.src} width="1254" height="1254" alt="" aria-hidden="true" />
              </div>
              <article class="offer-card">
                <h3>Hire AI Agents.</h3>
                <p class="offer-description">Bring in a specialist bee for store conversion, order follow-ups, or marketing workflows. Each agent works from your brand context, and your people review what matters.</p>
                <div class="offer-signature"><span class="signature-bees" aria-hidden="true"><img src={shopifyBee.src} width="30" height="30" alt="" loading="lazy" /><img src={marketingBee.src} width="30" height="30" alt="" loading="lazy" /><img src={callingBee.src} width="30" height="30" alt="" loading="lazy" /></span>One queen. A connected hive.</div>
                <a class="pill-button offer-cta" href="#services" data-cta-location="home-hire-agents"><span>Explore agents</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span></a>
              </article>
            </div>
          </div>
          <p class="approach-note">Your people stay in control. The hive helps them get more done.</p>
        </section>

        <section id="services" class="services-section" aria-labelledby="services-title">
          <p class="eyebrow">ONE QUEEN. ONE CONNECTED TEAM.</p>
          <h2 id="services-title">Meet your new team<br />of AI bees<span class="yellow-period">.</span></h2>
          <p class="services-intro">Specialist agents, working together around your brand.</p>
          <div class="team-orbit">
            <BeeOrbit />
          </div>
        </section>

        <section id="how-it-works" class="brain-section" aria-labelledby="brain-section-title">
          <h2 id="brain-section-title">How it works.</h2>
          <div class="brain-grid">
            <div class="brain-copy">
              <h3>Marketing Brain. <br/> For Better Ads.</h3>
              <p>Marketing Brain brings approved brand knowledge, customer questions, and campaign learning into one working context. It shapes content ideas, creative briefs, and ad angles. Your team reviews the output; managed marketing can put approved campaigns into market.</p>
              <a class="brain-link" href="/services/ai-automation">
                <img src={marketingBee.src} width="1254" height="1254" alt="" loading="lazy" />
                <span>Marketing Brain</span>
                <span class="brain-link-arrow" aria-hidden="true">→</span>
              </a>
            </div>
            <div class="brain-video-shell">
              <div class="brain-video-stage">
                <video data-brain-video autoplay muted loop playsinline preload="metadata" poster="/video/marketing-brain-flow-poster.png" aria-label="Marketing Brain animation: approved brand and campaign context becomes creative ideas for human review">
                  <source src="/video/marketing-brain-flow.mp4" type="video/mp4" />
                  Your browser does not support this video.
                </video>
              </div>
            </div>
          </div>
        </section>

        <section class="proof-section" aria-labelledby="proof-title">
          <div class="proof-inner">
            <div class="proof-heading">
              <h2 id="proof-title">Built from real brand<br />operations.</h2>
              <p>By <strong><span>Mlabs</span>Growth.</strong></p>
            </div>
            <div class="proof-stats" aria-label="How we work">
              <div><strong>{ownedBrands.length}</strong><span>owned brands</span></div>
              <div><strong>{serviceRoutes.length}</strong><span>service areas</span></div>
              <div><strong>30 min</strong><span>free first audit</span></div>
            </div>
            <div class="proof-gallery" aria-label="Illustrations of our people, agents, and workflows">
              <figure class="proof-image proof-person"><img src={humanStrategist.src} width="1149" height="1368" alt="Illustration of a human strategist" loading="lazy" /><figcaption>Human-led decisions</figcaption></figure>
              <figure class="proof-image proof-queen"><img src={queen.src} width="1254" height="1254" alt="Queen bee representing the connected agents" loading="lazy" /><figcaption>One connected hive</figcaption></figure>
              <figure class="proof-image proof-team"><img src={shopifyBee.src} width="1254" height="1254" alt="" loading="lazy" /><img src={marketingBee.src} width="1254" height="1254" alt="" loading="lazy" /><img src={callingBee.src} width="1254" height="1254" alt="" loading="lazy" /><figcaption>Specialists for the work</figcaption></figure>
            </div>
            <div class="proof-brands">
              <h3>Grounded in our own businesses.</h3>
              <div class="proof-brand-list">{ownedBrands.map(brand => <span>{brand.name}</span>)}</div>
            </div>
            <p class="proof-disclosure">{ownershipDisclosure}</p>
          </div>
        </section>

        <section class="closing-cta" aria-labelledby="closing-title">
          <div class="closing-lines" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="closing-copy">
            <h2 id="closing-title">Ready to make your store work harder?</h2>
            <a class="pill-button" href={site.bookingUrl} data-cta-location="home-closing"><span>Book a free audit</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span></a>
            <p>Bring one problem. We’ll agree on the scope before paid work begins.</p>
          </div>
        </section>
      </main>
      <footer class="preview-footer">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <nav aria-label="Footer"><a href="/services">Services</a><a href="/products">Products</a><a href="/about">About</a></nav>
      </footer>
    </div>
  </body>
</html>

<style>
  @font-face { font-family: 'Quicksand Hero'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/hero/quicksand-500-latin.woff2') format('woff2'); }
  @font-face { font-family: Caveat; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/caveat/caveat-medium.ttf') format('truetype'); }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; }
  :global(:focus-visible) { outline: 2px solid #986500; outline-offset: 5px; }
  .hive-page { --ink: #111116; --muted: #707178; --yellow: #ffcc1e; --cream: #f6f5f1; min-width: 320px; overflow: clip; background: var(--cream); color: var(--ink); font-family: 'Manrope Variable', Manrope, Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  h1,h2,h3,p { margin-top: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .skip-link { position: fixed; z-index: 100; top: -100px; left: 18px; padding: 12px 16px; background: #fff; border-radius: 12px; }
  .skip-link:focus { top: 10px; }
  .pill-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 54px; padding: 5px 5px 5px 24px; border-radius: 999px; background: var(--yellow); box-shadow: 0 8px 18px #825f0026, inset 0 -2px 3px #7f5c0024; font-size: 15px; font-weight: 800; white-space: nowrap; transition: transform .25s, box-shadow .25s; }
  .pill-button:hover { transform: translateY(-2px); box-shadow: 0 12px 25px #825f0033, inset 0 -2px 3px #7f5c0024; }
  .pill-arrow { display: grid; place-items: center; width: 44px; height: 44px; flex: 0 0 auto; border: 1px solid #fff; border-radius: 50%; background: #ffffff61; box-shadow: 0 1px 5px #533a001f; }
  .pill-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hero { padding: clamp(180px,13.7vw,240px) 24px 0; }
  .hero-copy { max-width: 900px; margin: 0 auto; text-align: center; }
  h1 { margin-bottom: 30px; font-family: 'Quicksand Hero', 'Manrope Variable', sans-serif; font-size: clamp(46px,5vw,78px); line-height: 1.08; font-weight: 500; letter-spacing: -.065em; }
  h1 span { display: block; text-wrap: balance; }
  .hero-subtitle { max-width: 690px; margin: 0 auto 30px; color: var(--muted); font-size: clamp(16px,1.25vw,20px); line-height: 1.55; letter-spacing: -.025em; }
  .hero-cta { min-width: 250px; min-height: 50px; margin: 0 auto; font-size: 14px; }
  .hero-cta .pill-arrow { width: 40px; height: 40px; }
  .hero-note { margin: 15px auto 0; color: #777872; font-size: 12px; line-height: 1.5; }
  .approach-section { position: relative; padding: 145px 24px 40px; scroll-margin-top: 120px; --visual-start-scale: 1.38; --visual-scale: 1.38; --visual-start-lift: 70px; --visual-lift: 70px; }
  .offer-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28px; max-width: 900px; margin: auto; }
  .offer-column { min-width: 0; display: flex; flex-direction: column; }
  .offer-visual { position: relative; height: 370px; isolation: isolate; transform: translateY(calc(-1 * var(--visual-lift))) scale(var(--visual-scale)); transform-origin: center bottom; transition: transform .18s ease-out; }
  .visual-halo { position: absolute; z-index: -1; left: 50%; bottom: 0; width: 110%; height: 270px; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(ellipse,#f1d9c752,transparent 70%); filter: blur(25px); }
  .human-visual img { position: absolute; left: 50%; top: 7px; width: 440px; max-width: 112%; height: auto; transform: translateX(-50%); filter: drop-shadow(0 12px 16px #76562c0a); }
  .agents-visual .visual-halo { background: radial-gradient(ellipse,#ffe5ad66,transparent 70%); }
  .offer-bee { position: absolute; height: auto; filter: drop-shadow(0 14px 17px #95661c1f); }
  .bee-queen { z-index: 1; width: 340px; max-width: 84%; top: 0; left: 0; right: 0; margin-inline: auto; animation: queen-float 7s ease-in-out infinite; }
  .bee-satellite-left { z-index: 2; left: -13px; bottom: -8px; width: 175px; transform: rotate(-10deg); animation: satellite-left-float 6s ease-in-out infinite; }
  .bee-satellite-right { z-index: 2; right: -10px; bottom: -18px; width: 174px; transform: rotate(10deg); animation: satellite-right-float 6.5s ease-in-out infinite; }
  .offer-card { position: relative; z-index: 3; flex: 1; display: flex; flex-direction: column; min-height: 320px; padding: 35px 36px 34px; border: 1px solid #ffffffb3; border-radius: 23px; background: #fff; box-shadow: 0 10px 28px #4b3c1805; }
  .offer-card h3 { margin-bottom: 16px; font-size: clamp(28px,2.5vw,36px); line-height: 1.15; font-weight: 750; letter-spacing: -.055em; }
  .offer-card h3 em { display: inline-block; font-family: Caveat, 'Segoe Print', cursive; font-size: 1.27em; font-style: normal; font-weight: 500; line-height: .8; letter-spacing: -.04em; }
  .offer-description { margin-bottom: 26px; color: var(--muted); font-size: 16px; line-height: 1.6; letter-spacing: -.015em; }
  .offer-card ul { display: grid; gap: 13px; margin: 0 0 25px; padding: 20px 0 0; border-top: 1px solid #ebebe6; list-style: none; color: #45464b; font-size: 14px; line-height: 1.55; }
  .offer-card li { position: relative; padding-left: 13px; }
  .offer-card li::before { content: ''; position: absolute; top: .66em; left: 0; width: 3px; height: 3px; border-radius: 50%; background: #9d9d96; }
  .offer-signature { display: inline-flex; align-items: center; align-self: flex-start; gap: 8px; min-height: 38px; margin: auto 0 27px; padding: 5px 12px; border-radius: 999px; background: #f6f5f0; color: #626159; font-size: 12px; white-space: nowrap; }
  .signature-dot { width: 8px; height: 8px; border-radius: 50%; background: #e4b61d; box-shadow: 0 0 0 5px #f3e9c2; margin: 0 6px; }
  .signature-bees { display: flex; padding-right: 2px; }
  .signature-bees img { width: 28px; height: 28px; margin-right: -8px; border: 2px solid #fff; border-radius: 50%; background: #fcebc3; object-fit: cover; }
  .signature-bees img:last-child { margin-right: 0; }
  .offer-cta { align-self: flex-start; min-width: 210px; }
  .approach-note { max-width: 560px; margin: 40px auto 0; color: #777872; text-align: center; font-size: 14px; line-height: 1.6; }
  @media (min-width: 1600px) {
    .approach-section { padding-top: 70px; }
  }
  .eyebrow { margin-bottom: 18px; color: #81745c; font-size: 11px; font-weight: 800; letter-spacing: .17em; }
  .yellow-period { color: var(--yellow); }
  .services-section { padding: 95px 28px 60px; text-align: center; scroll-margin-top: 110px; }
  .services-section h2 { margin-bottom: 13px; font-size: clamp(42px,5.3vw,75px); line-height: 1.04; font-weight: 600; letter-spacing: -.065em; }
  .services-intro { margin: 0 auto 44px; max-width: 550px; color: var(--muted); font-size: 17px; line-height: 1.6; }
  .team-orbit { width: 100%; max-width: 1180px; margin: 0 auto; }
  .brain-section { padding: 60px 28px 100px; background: var(--cream); scroll-margin-top: 90px; }
  .brain-section > h2 { margin: 0 auto 60px; text-align: center; font-size: clamp(36px,4vw,56px); font-weight: 600; letter-spacing: -.07em; }
  .brain-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.08fr); align-items: center; gap: clamp(40px,5vw,80px); max-width: 1200px; margin: auto; }
  .brain-copy h3 { margin-bottom: 22px; font-size: clamp(46px,5vw,76px); font-weight: 600; line-height: .99; letter-spacing: -.078em; }
  .brain-copy > p { max-width: 590px; margin-bottom: 30px; color: #5c5e65; font-size: clamp(16px,1.2vw,19px); line-height: 1.55; letter-spacing: -.015em; }
  .brain-link { display: flex; align-items: center; gap: 16px; max-width: 590px; min-height: 64px; border-top: 1px solid #dbd9d3; font-size: clamp(16px,1.4vw,20px); font-weight: 700; letter-spacing: -.035em; }
  .brain-link > img { width: 48px; height: 48px; object-fit: contain; filter: drop-shadow(0 5px 5px #65502f3d); }
  .brain-link-arrow { display: grid; place-items: center; width: 44px; height: 44px; margin-left: auto; border-radius: 50%; background: #eae6dc; font-size: 28px; font-weight: 400; transition: transform .2s,background .2s; }
  .brain-link:hover .brain-link-arrow { transform: translateX(3px); background: var(--yellow); }
  .brain-video-shell { min-width: 0; padding: clamp(18px,2.2vw,32px); border-radius: 30px; background: #fff; box-shadow: 0 25px 60px #5a4f3710; }
  .brain-video-stage { position: relative; overflow: hidden; aspect-ratio: 728/624; border-radius: 24px; background: #f7f7f6; }
  .brain-video-stage video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .proof-section { background: radial-gradient(ellipse at 50% 0%,#292929 0%,#1b1b1b 58%,#191919 100%); color: #f8f8f7; }
  .proof-inner { max-width: 1280px; margin: auto; padding: 78px 28px 86px; }
  .proof-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; padding-bottom: 42px; border-bottom: 1px solid #ffffff25; }
  .proof-heading h2 { margin: 0; font-size: clamp(25px,2.7vw,38px); font-weight: 600; line-height: 1.22; letter-spacing: -.055em; }
  .proof-heading p { margin: 8px 0 0; color: #aaa9a6; font-size: 12px; white-space: nowrap; }
  .proof-heading strong { margin-left: 8px; color: #f7f6f3; font-size: 17px; font-weight: 850; letter-spacing: -.06em; }
  .proof-heading strong span { color: var(--yellow); }
  .proof-stats { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 20px; padding: 32px 0 34px; }
  .proof-stats div { display: flex; flex-direction: column; gap: 3px; }
  .proof-stats strong { font-size: clamp(35px,4vw,56px); font-weight: 650; line-height: 1.05; letter-spacing: -.055em; }
  .proof-stats div:not(:first-child) strong { font-size: clamp(27px,2.8vw,39px); }
  .proof-stats span { color: #a5a5a4; font-size: 12px; }
  .proof-gallery { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
  .proof-image { position: relative; display: grid; place-items: center; height: clamp(190px,19vw,255px); margin: 0; overflow: hidden; border-radius: 10px; background: radial-gradient(circle at 50% 65%,#f3e5cc 0%,#d3c5b0 64%,#9b8c79 100%); }
  .proof-image img { display: block; width: auto; height: 96%; object-fit: contain; }
  .proof-person img { align-self: end; height: 120%; transform: translateY(19%); }
  .proof-queen { background: radial-gradient(circle at 50% 52%,#fff3d5 0%,#d6bb91 72%,#7e684e 100%); }
  .proof-queen img { height: 118%; filter: drop-shadow(0 10px 16px #5e3c222b); }
  .proof-team { background: radial-gradient(circle at 50% 55%,#ded7ee 0%,#c3b7d1 60%,#806d8c 100%); }
  .proof-team img { position: absolute; height: 71%; filter: drop-shadow(0 10px 12px #2f243338); }
  .proof-team img:nth-child(1) { left: -3%; bottom: 6%; }
  .proof-team img:nth-child(2) { left: 28%; bottom: 20%; z-index: 1; }
  .proof-team img:nth-child(3) { right: -3%; bottom: 5%; }
  .proof-image figcaption { position: absolute; z-index: 2; left: 13px; bottom: 12px; padding: 6px 10px; border-radius: 999px; background: #1b1b1bcc; color: #fff; font-size: 11px; font-weight: 700; backdrop-filter: blur(8px); }
  .proof-brands { display: flex; justify-content: space-between; align-items: center; gap: 40px; margin-top: 34px; padding-top: 32px; border-top: 1px solid #ffffff25; }
  .proof-brands h3 { max-width: 330px; margin: 0; font-size: clamp(20px,2.3vw,30px); font-weight: 600; line-height: 1.18; letter-spacing: -.05em; }
