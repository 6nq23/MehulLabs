---
import { site } from '@/data/site';
import Layout from '@/layouts/Layout.astro';
import { CalculatorApp } from '@/components/tools/CalculatorApp';
import { tools } from '@/data/tools';
import { toolContent } from '@/data/toolContent';
import { toolSearchContent } from '@/data/searchContent';
import { serviceRoutes } from '@/data/services';
import { guides } from '@/data/guides';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

type Tool = (typeof tools)[number];
interface Props { tool: Tool }
const { tool } = Astro.props;
const content = toolContent[tool.slug];
const searchContent = toolSearchContent[tool.slug];
const relatedGuide = guides.find(guide => guide.service === searchContent.service)!;
const relatedService = serviceRoutes.find(service => service.slug === searchContent.service)!;
---

<Layout>
  <div class="calculator-page">
    <header class="calculator-hero">
      <div class="shell">
        <a href="/tools" class="calculator-back"><span aria-hidden="true">←</span> All tools</a>
        <div class="calculator-title-row">
          <div>
            <p class="tools-kicker"><span aria-hidden="true"></span> {content.eyebrow}</p>
            <h1>{tool.title}</h1>
          </div>
          <p>{content.intro}</p>
        </div>
        <nav class="tool-switcher" aria-label="Choose a calculator">
          {tools.map((item) => (
            <a href={`/tools/${item.slug}`} aria-current={item.slug === tool.slug ? 'page' : undefined}>
              <span>{item.number}</span>{item.title.replace(' Calculator', '').replace(' Planner', '')}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <section class="shell calculator-main" aria-label={`${tool.title} workspace`}>
      <CalculatorApp toolId={tool.slug} client:load />
      <div class="calculator-formula-bar">
        <span>Core calculation</span>
        <code>{tool.formula}</code>
      </div>
    </section>
    <p class="shell growth-note">Scenario estimate based on your inputs. It does not connect to your store or replace actual settlement and cost reports.</p>
    <noscript><p class="shell growth-note">Enable JavaScript to update the calculator. The formula, worked example and explanations below remain available without it.</p></noscript>
    <section class="section-space shell" aria-labelledby="calculation-method">
      <h2 id="calculation-method" class="section-title">How to use this calculator</h2>
      <div class="seo-help-grid"><div><p>{searchContent.steps}</p><h3>Worked example</h3><p>{searchContent.example}</p></div><div><h3>What the estimate leaves out</h3><p>{searchContent.limit}</p><p>Use inputs from the same reporting period and compare the result with your actual costs before making a decision.</p><a class="text-link" href={`/services/${relatedService.slug}`}>Explore {relatedService.navLabel.toLowerCase()} services ↗</a></div></div>
    </section>
    <p class="shell"><a class="text-link" href={`/guides/${relatedGuide.slug}`}>{relatedGuide.title} ↗</a></p>
    <section class="tool-education">
      <div class="shell">
        <div class="education-intro"><p class="eyebrow-accent">Why it matters</p><h2>{content.whyTitle}</h2><p>{content.whyIntro}</p></div>
        <ol class="education-grid">{content.reasons.map((reason, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{reason[0]}</h3><p>{reason[1]}</p></li>)}</ol>
      </div>
    </section>
    <section class="tool-faq shell" aria-labelledby="tool-faq-title">
      <div><p class="eyebrow-accent">Frequently asked</p><h2 id="tool-faq-title">Straight answers.</h2></div>
      <div>{content.faqs.map((faq) => <details><summary>{faq[0]}<span aria-hidden="true">+</span></summary><p>{faq[1]}</p></details>)}</div>
    </section>
    <section class="section-space growth-product-band"><div class="shell growth-callout"><div><h2>Found a cost worth investigating?</h2><p>Bring the problem to a free audit. We’ll help you work out which workflow to review first.</p></div><a class="growth-button" href={site.bookingUrl} data-cta-location={`tool-${tool.slug}-audit`}>Discuss the next step ↗</a></div></section>
  </div>
</Layout>
