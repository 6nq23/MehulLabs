---
import { Footer } from '@/components/layout/Footer';
import { SiteRuntime } from '@/components/layout/SiteRuntime';
import { contactEmail, site } from '@/data/site';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonicalUrl = site.url
  ? Astro.url.pathname === '/'
    ? site.url
    : new URL(Astro.url.pathname, `${site.url}/`).toString()
  : undefined;
const socialImageUrl = new URL('/social-preview.png', site.url || Astro.url.origin).toString();
const robots = site.url ? 'index, follow' : 'noindex, nofollow';
const googlebot = `${robots}, max-image-preview:large`;
const keywords = [
  'D2C infrastructure',
  'D2C order management',
  'Shopify conversion rate optimization',
  'Shopify smart cart',
  'AI calling agent',
  'COD confirmation calls',
  'AI workflow automation',
  'Claude Brain for marketing',
  site.name,
].join(', ');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url || undefined,
  email: contactEmail || undefined,
  description: site.tagline,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F7F2" />
    <meta name="color-scheme" content="light" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={site.name} />
    <meta name="creator" content={site.name} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={googlebot} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {site.url && <link rel="author" href={site.url} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="mlabs Growth — practical AI workflows, products and brand services" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>

    <noscript>
      <style is:inline>
        [data-reveal], [data-word] { opacity: 1 !important; transform: none !important; }
        .film-play, .film-corner, .enquiry-form { display: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <SiteRuntime pathname={Astro.url.pathname} client:load />
    <noscript><nav class="no-js-navigation" aria-label="Page navigation"><a href="/">Home</a><a href="/#services">Services</a><a href="/products">Products</a><a href="/about">About</a><a href="/offers">Pricing &amp; scope</a><a href="/tools">Free tools</a></nav></noscript>
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
