---
import { Footer } from '@/components/layout/Footer';
import HiveNavbar from '@/components/layout/HiveNavbar.astro';
import { SiteRuntime } from '@/components/layout/SiteRuntime';
import WhatsAppButton from '@/components/layout/WhatsAppButton.astro';
import fs from 'node:fs';
import path from 'node:path';
import { founderDisplayName, site } from '@/data/site';
import { organizationId, organizationNode, personId, personNode, websiteId, websiteNode } from '@/data/schema';
import { guides } from '@/data/guides';
import { tools } from '@/data/tools';
import { metaPixelNoscriptSrc, metaPixelScript } from '@/data/metaPixel';
import { pageSeo, breadcrumbsFor } from '@/data/seo';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  article?: {
    publishedOn: string;
    updatedOn?: string;
    author?: string;
    category?: string;
    image?: string;
    imageAlt?: string;
    /** Raster social card generated by scripts/generate-og-images.cjs (1200×630). */
    ogImage?: string;
    wordCount?: number;
    faqs?: readonly { question: string; answer: string }[];
  };
}

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const entry = pageSeo[pathname];
const { title = entry?.title, description = entry?.description || site.tagline, noindex = false, article } = Astro.props;
// Keep the brand suffix only while the whole title still fits in a search result (~60 characters).
const suffix = ` — ${site.name}`;
const pageTitle = title ? (title.length + suffix.length <= 62 ? `${title}${suffix}` : title) : `${site.name} — ${site.role}`;
const canonicalUrl = site.url && !noindex ? new URL(pathname, `${site.url}/`).href : undefined;
// Social networks do not render SVG, so articles use their generated PNG card, then a raster cover, then the site card.
const publicFile = (src?: string) => !!src && src.startsWith('/') && fs.existsSync(path.join(process.cwd(), 'public', decodeURIComponent(src)));
const rasterCover = article?.image && !/\.svg$/i.test(article.image) ? article.image : undefined;
const socialImagePath = publicFile(article?.ogImage) ? article!.ogImage! : publicFile(rasterCover) ? rasterCover! : '/social-preview.png';
const socialImageSize = socialImagePath === rasterCover ? null : { width: 1200, height: 630 };
const socialImageUrl = new URL(socialImagePath, site.url || Astro.url.origin).href;
const socialImageAlt = article?.image && article.imageAlt ? article.imageAlt : 'MlabsGrowth — Shopify CRO, COD order automation and AI marketing workflows';
const indexable = site.indexable && !noindex;
const robots = indexable ? 'index, follow' : 'noindex, follow';
const googlebot = `${robots}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`;
const breadcrumbs = article
  ? [{ path: '/', label: 'Home' }, { path: '/blog', label: 'Blog' }, { path: pathname, label: title || 'Article' }]
  : breadcrumbsFor(pathname);
const graph: Record<string, unknown>[] = [
  organizationNode(),
  personNode(),
  websiteNode(),
  { '@type': entry?.type || 'WebPage', '@id': `${canonicalUrl}#webpage`, url: canonicalUrl, name: pageTitle, description, isPartOf: { '@id': websiteId }, publisher: { '@id': organizationId }, inLanguage: 'en', ...(pathname === '/about' ? { mainEntity: { '@id': personId } } : {}), ...(breadcrumbs.length ? { breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` } } : {}) },
];
if (breadcrumbs.length) graph.push({ '@type': 'BreadcrumbList', '@id': `${canonicalUrl}#breadcrumb`, itemListElement: breadcrumbs.map((crumb, index) => ({ '@type': 'ListItem', position: index + 1, name: crumb.label, item: new URL(crumb.path, `${site.url || Astro.url.origin}/`).href })) });
if (pathname.startsWith('/services/') && entry) graph.push({ '@type': 'Service', '@id': `${canonicalUrl}#service`, name: entry.title, description, url: canonicalUrl, provider: { '@id': organizationId }, areaServed: site.areaServed, mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` } });
const guide = guides.find(item => pathname === `/guides/${item.slug}`);
if (guide && entry) graph.push({ '@type': 'Article', '@id': `${canonicalUrl}#article`, headline: entry.title, description, datePublished: guide.publishedOn, dateModified: guide.updatedOn || guide.publishedOn, author: { '@id': personId }, publisher: { '@id': organizationId }, mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` }, inLanguage: 'en' });
if (article) graph.push({
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: title,
  description,
  datePublished: article.publishedOn,
  dateModified: article.updatedOn || article.publishedOn,
  author: { '@id': personId },
  publisher: { '@id': organizationId },
  image: socialImageUrl,
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  articleSection: article.category,
  wordCount: article.wordCount,
  inLanguage: 'en',
});
if (article?.faqs?.length) graph.push({
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: article.faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
});
const calculator = tools.find(tool => pathname === `/tools/${tool.slug}`);
if (calculator) graph.push({ '@type': 'WebApplication', '@id': `${canonicalUrl}#calculator`, name: calculator.title, description: entry.description, url: canonicalUrl, applicationCategory: 'BusinessApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript and a modern web browser.', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@id': organizationId }, mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` } });
if (pathname === '/tools') graph.push({ '@type': 'ItemList', '@id': `${canonicalUrl}#calculators`, name: 'Free ecommerce calculators', numberOfItems: tools.length, itemListElement: tools.map((tool, index) => ({ '@type': 'ListItem', position: index + 1, name: tool.title, url: `${site.url}/tools/${tool.slug}` })) });
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();

---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J6P4JDHNVJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-J6P4JDHNVJ');
    </script>
    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yss8eahqun");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffcb16" />
    <meta name="color-scheme" content="light" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta name="author" content={article ? founderDisplayName : site.name} />
    <meta name="creator" content={site.name} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={googlebot} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {site.url && <link rel="author" href={site.url} />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    {socialImageSize && <meta property="og:image:width" content={String(socialImageSize.width)} />}
    {socialImageSize && <meta property="og:image:height" content={String(socialImageSize.height)} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    {article && <meta property="article:published_time" content={article.publishedOn} />}
    {article && <meta property="article:modified_time" content={article.updatedOn || article.publishedOn} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/mlabsgrowth-icon.png" type="image/png" sizes="1024x1024" />
    <link rel="apple-touch-icon" href="/mlabsgrowth-icon.png" />
    {site.url && !noindex && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    {site.indexable && <script is:inline set:html={metaPixelScript}></script>}

    <noscript>
      <style is:inline>
        [data-reveal], [data-word] { opacity: 1 !important; transform: none !important; }
        .enquiry-form { display: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    {site.indexable && <noscript><img height="1" width="1" style="display:none" alt="" src={metaPixelNoscriptSrc} /></noscript>}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <SiteRuntime pathname={Astro.url.pathname} client:load />
    <HiveNavbar />
    <noscript><nav class="no-js-navigation" aria-label="Page navigation"><a href="/services">Services</a><a href="/products">Products</a><a href="/blog">Blog</a><a href="/about">About</a><a href="/offers">Pricing &amp; scope</a><a href="/tools">Free tools</a><a href="/guides">Guides</a></nav></noscript>
    <main id="main">
      {breadcrumbs.length > 0 && <nav class="seo-breadcrumbs shell" aria-label="Breadcrumb"><ol>{breadcrumbs.map((crumb, index) => <li>{index === breadcrumbs.length - 1 ? <span aria-current="page">{crumb.label}</span> : <a href={crumb.path}>{crumb.label}</a>}</li>)}</ol></nav>}
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
