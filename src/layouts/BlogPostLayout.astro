---
import fs from 'node:fs';
import Layout from '@/layouts/Layout.astro';
import { founder, founderDisplayName } from '@/data/site';
import { getRelatedPosts, readingStats } from '@/lib/blog';

interface Frontmatter {
  title: string;
  description: string;
  publishedOn: string;
  updatedOn?: string;
  category?: string;
  author?: string;
  readTime?: string;
  coverImage?: string;
  coverImageAlt?: string;
  faqs?: readonly { question: string; answer: string }[];
  draft?: boolean;
}

const { frontmatter, file } = Astro.props as { frontmatter: Frontmatter; file?: string };

if (frontmatter.draft) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}

const pathname = Astro.url.pathname.replace(/\/$/, '');
const slug = pathname.split('/').pop()!;
const updated = frontmatter.updatedOn && frontmatter.updatedOn !== frontmatter.publishedOn ? frontmatter.updatedOn : undefined;
// Measured from the source file at build time, so schema wordCount and read time stay honest.
const stats = file && fs.existsSync(file) ? readingStats(fs.readFileSync(file, 'utf8')) : undefined;
const related = await getRelatedPosts(pathname, frontmatter.category, frontmatter.title);
const formatDate = (date: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(date));
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  article={{
    publishedOn: frontmatter.publishedOn,
    updatedOn: frontmatter.updatedOn,
    author: founderDisplayName,
    category: frontmatter.category,
    image: frontmatter.coverImage,
    imageAlt: frontmatter.coverImageAlt,
    ogImage: `/Blogs/${slug}/og-card.png`,
    wordCount: stats?.words,
    faqs: frontmatter.faqs,
  }}
>
  <article class="blog-post">
    <header class="blog-post-header">
      <div class="shell blog-post-header-inner">
        <a class="blog-post-back" href="/blog"><span aria-hidden="true">←</span> All articles</a>
        <p class="tools-kicker"><span aria-hidden="true"></span> {frontmatter.category || 'Field note'}</p>
        <h1>{frontmatter.title}</h1>
        <p class="blog-post-dek">{frontmatter.description}</p>
        <div class="blog-post-meta">
          <span>By <a href="/about" rel="author">{founderDisplayName}</a></span>
          <span>Published <time datetime={frontmatter.publishedOn}>{formatDate(frontmatter.publishedOn)}</time></span>
          {updated && <span>Updated <time datetime={updated}>{formatDate(updated)}</time></span>}
          {(stats?.readTime || frontmatter.readTime) && <span>{stats?.readTime || frontmatter.readTime}</span>}
        </div>
      </div>
    </header>
    <div class="shell blog-post-body">
      <div class="blog-prose">
        <slot />
      </div>
      <aside class="blog-author-card" aria-label="About the author">
        <p class="blog-author-kicker">About the author</p>
        <p><strong><a href="/about">{founderDisplayName}</a></strong> · {founder.jobTitle}</p>
        <p>{founder.name} runs two D2C brands and builds the systems underneath them: Shopify conversion, COD and delivery follow-up, and reviewable AI marketing workflows. MlabsGrowth builds the same layer for ecommerce brands in any country.</p>
        <p><a href="/services">See what we fix</a> · <a href="/about">More about {founder.name}</a></p>
      </aside>
      {related.length > 0 && (
        <nav class="blog-related" aria-labelledby="related-title">
          <h2 id="related-title">Keep reading</h2>
          <ul>
            {related.map(post => (
              <li>
                <a href={post.url}>
                  <span>{post.frontmatter.category || 'Field note'}</span>
                  <strong>{post.frontmatter.title}</strong>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>
</Layout>
